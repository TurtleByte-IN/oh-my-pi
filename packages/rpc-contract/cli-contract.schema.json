{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://omp.sh/schemas/cli-contract.json",
	"title": "omp CLI JSON outputs",
	"description": "Generated by `bun run gen:rpc` from packages/coding-agent/src/cli/contract. Each `x-cli` command prints one JSON document matching its `output` definition on stdout.",
	"x-cli": {
		"commands": [
			{
				"name": "config list",
				"usage": "omp config list --json [--cwd <path>]",
				"output": "CliConfigList"
			},
			{
				"name": "config list --scope",
				"usage": "omp config list --scope global|project --json [--cwd <path>]",
				"output": "CliConfigLayerList"
			},
			{
				"name": "config set",
				"usage": "omp config set <key> <value> --json [--scope global|project] [--cwd <path>]",
				"output": "CliConfigSetResult"
			},
			{
				"name": "config reset",
				"usage": "omp config reset <key> --json [--scope global|project] [--cwd <path>]",
				"output": "CliConfigResetResult"
			},
			{
				"name": "models",
				"usage": "omp models [ls|find|refresh] [pattern] --json [--kind <kind>]",
				"output": "CliModelsList"
			},
			{
				"name": "plugin list",
				"usage": "omp plugin list --json",
				"output": "CliPluginList"
			},
			{
				"name": "skill list",
				"usage": "omp skill list [dir] --json",
				"output": "CliSkillList"
			}
		]
	},
	"$defs": {
		"CliSettingSource": {
			"enum": [
				"default",
				"global",
				"project",
				"overlay",
				"runtime",
				"env"
			],
			"type": "string",
			"description": "Layer supplying a setting's effective value: `default` (schema default), `global` (agent dir `config.yml`), `project` (`<cwd>/.omp/config.yml` and other project settings files), `overlay` (`--config` / `PI_CONFIG_FILES`), `runtime` (process override), `env` (environment variable; read-only for hosts)."
		},
		"CliSettingType": {
			"enum": [
				"boolean",
				"string",
				"number",
				"enum",
				"array",
				"record"
			],
			"type": "string",
			"description": "Value type of a setting."
		},
		"CliConfigScope": {
			"enum": [
				"global",
				"project"
			],
			"type": "string",
			"description": "Config file `config set` and `config reset` write."
		},
		"CliConfigEntry": {
			"type": "object",
			"properties": {
				"type": {
					"$ref": "#/$defs/CliSettingType"
				},
				"description": {
					"type": "string"
				},
				"source": {
					"$ref": "#/$defs/CliSettingSource"
				},
				"value": {
					"description": "Effective value; absent when the setting has no value or is redacted."
				},
				"redacted": {
					"const": true,
					"description": "Set when a credential is configured: `value` is withheld."
				}
			},
			"required": [
				"type",
				"description",
				"source"
			],
			"additionalProperties": false,
			"description": "One setting in `omp config list --json`."
		},
		"CliConfigList": {
			"type": "object",
			"properties": {},
			"additionalProperties": {
				"$ref": "#/$defs/CliConfigEntry"
			},
			"description": "`omp config list --json`: every setting by key."
		},
		"CliConfigLayerEntry": {
			"type": "object",
			"properties": {
				"type": {
					"$ref": "#/$defs/CliSettingType"
				},
				"description": {
					"type": "string"
				},
				"value": {
					"description": "Value as the layer holds it: path-scoped arrays (`enabledModels`, `enabledProviders`, `disabledProviders`) keep their `{ path, … }` entries unresolved. Absent when redacted."
				},
				"redacted": {
					"const": true,
					"description": "Set when the layer holds a non-empty credential: `value` is withheld."
				}
			},
			"required": [
				"type",
				"description"
			],
			"additionalProperties": false,
			"description": "One setting in `omp config list --scope <scope> --json`."
		},
		"CliConfigLayerList": {
			"type": "object",
			"properties": {},
			"additionalProperties": {
				"$ref": "#/$defs/CliConfigLayerEntry"
			},
			"description": "`omp config list --scope global|project --json`: only the keys that layer sets, by key."
		},
		"CliConfigSetResult": {
			"type": "object",
			"properties": {
				"key": {
					"type": "string"
				},
				"scope": {
					"$ref": "#/$defs/CliConfigScope"
				},
				"value": {
					"description": "Value the scope's config file now holds."
				},
				"overriddenBy": {
					"type": "string",
					"description": "Higher layer (`project`, `overlay`, `runtime`) or environment variable name that still supplies the effective value."
				},
				"fallbackEnv": {
					"type": "string",
					"description": "Environment variable used while the saved value is blank."
				}
			},
			"required": [
				"key",
				"scope"
			],
			"additionalProperties": false,
			"description": "`omp config set <key> <value> --json`."
		},
		"CliConfigResetResult": {
			"type": "object",
			"properties": {
				"key": {
					"type": "string"
				},
				"scope": {
					"$ref": "#/$defs/CliConfigScope"
				},
				"value": {
					"description": "Effective value after the reset; absent when unset or redacted."
				},
				"redacted": {
					"const": true,
					"description": "Set when the effective value is a configured credential."
				}
			},
			"required": [
				"key",
				"scope"
			],
			"additionalProperties": false,
			"description": "`omp config reset <key> --json`."
		},
		"CliModelKind": {
			"enum": [
				"chat",
				"tiny",
				"image",
				"tts",
				"stt",
				"search",
				"judge",
				"embedding",
				"rerank",
				"video"
			],
			"type": "string"
		},
		"CliEffort": {
			"enum": [
				"minimal",
				"low",
				"medium",
				"high",
				"xhigh",
				"max"
			],
			"type": "string"
		},
		"CliModelPricingStatus": {
			"enum": [
				"fixed",
				"free",
				"included",
				"variable",
				"unknown"
			],
			"type": "string"
		},
		"CliModelCost": {
			"type": "object",
			"properties": {
				"input": {
					"type": "number"
				},
				"output": {
					"type": "number"
				},
				"cacheRead": {
					"type": "number"
				},
				"cacheWrite": {
					"type": "number"
				}
			},
			"required": [
				"input",
				"output",
				"cacheRead",
				"cacheWrite"
			],
			"description": "Effective per-million-token rates now. Further pricing keys (`longContext`, `timeBased`) may be present and are not part of the contract."
		},
		"CliModel": {
			"type": "object",
			"properties": {
				"provider": {
					"type": "string"
				},
				"kind": {
					"$ref": "#/$defs/CliModelKind"
				},
				"id": {
					"type": "string"
				},
				"selector": {
					"type": "string",
					"description": "`provider/id`."
				},
				"name": {
					"type": "string"
				},
				"contextWindow": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					]
				},
				"maxTokens": {
					"anyOf": [
						{
							"type": "number"
						},
						{
							"type": "null"
						}
					]
				},
				"reasoning": {
					"type": "boolean"
				},
				"thinking": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"$ref": "#/$defs/CliEffort"
							}
						},
						{
							"type": "null"
						}
					],
					"description": "Supported thinking efforts when the model thinks, otherwise null."
				},
				"input": {
					"type": "array",
					"items": {
						"enum": [
							"text",
							"image"
						],
						"type": "string"
					}
				},
				"cost": {
					"$ref": "#/$defs/CliModelCost"
				},
				"pricingStatus": {
					"$ref": "#/$defs/CliModelPricingStatus"
				}
			},
			"required": [
				"provider",
				"kind",
				"id",
				"selector",
				"name",
				"contextWindow",
				"maxTokens",
				"reasoning",
				"thinking",
				"input",
				"cost",
				"pricingStatus"
			],
			"additionalProperties": false
		},
		"CliModelsList": {
			"type": "object",
			"properties": {
				"models": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/CliModel"
					}
				}
			},
			"required": [
				"models"
			],
			"additionalProperties": false,
			"description": "`omp models [ls|find|refresh] --json`."
		},
		"CliNpmPlugin": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"version": {
					"type": "string"
				},
				"path": {
					"type": "string"
				},
				"manifest": {
					"type": "object",
					"properties": {},
					"additionalProperties": {},
					"description": "The package's `omp` (or `pi`) manifest as published, with `version` copied from package.json."
				},
				"enabledFeatures": {
					"anyOf": [
						{
							"type": "array",
							"items": {
								"type": "string"
							}
						},
						{
							"type": "null"
						}
					],
					"description": "Enabled features; null uses the manifest defaults."
				},
				"enabled": {
					"type": "boolean"
				}
			},
			"required": [
				"name",
				"version",
				"path",
				"manifest",
				"enabledFeatures",
				"enabled"
			],
			"additionalProperties": false
		},
		"CliMarketplacePluginEntry": {
			"type": "object",
			"properties": {
				"installPath": {
					"type": "string"
				},
				"version": {
					"type": "string"
				},
				"installedAt": {
					"type": "string"
				},
				"lastUpdated": {
					"type": "string"
				},
				"scope": {
					"enum": [
						"user",
						"project"
					],
					"type": "string",
					"description": "Absent in registries written before scopes existed (user)."
				},
				"gitCommitSha": {
					"type": "string"
				},
				"enabled": {
					"type": "boolean"
				}
			},
			"required": [
				"installPath",
				"version",
				"installedAt",
				"lastUpdated"
			],
			"description": "One install record from the Claude-compatible `installed_plugins.json` registry; other keys pass through."
		},
		"CliMarketplacePlugin": {
			"type": "object",
			"properties": {
				"id": {
					"type": "string"
				},
				"scope": {
					"enum": [
						"user",
						"project"
					],
					"type": "string"
				},
				"entries": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/CliMarketplacePluginEntry"
					}
				},
				"shadowedBy": {
					"const": "project",
					"description": "Set on a user install that an enabled project install overrides."
				}
			},
			"required": [
				"id",
				"scope",
				"entries"
			],
			"additionalProperties": false
		},
		"CliPluginList": {
			"type": "object",
			"properties": {
				"npm": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/CliNpmPlugin"
					}
				},
				"marketplace": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/CliMarketplacePlugin"
					}
				}
			},
			"required": [
				"npm",
				"marketplace"
			],
			"additionalProperties": false,
			"description": "`omp plugin list --json`."
		},
		"CliSkill": {
			"type": "object",
			"properties": {
				"name": {
					"type": "string"
				},
				"description": {
					"type": "string"
				},
				"filePath": {
					"type": "string"
				},
				"baseDir": {
					"type": "string"
				},
				"source": {
					"type": "string"
				},
				"hide": {
					"type": "boolean"
				}
			},
			"required": [
				"name",
				"description",
				"filePath",
				"baseDir",
				"source",
				"hide"
			],
			"additionalProperties": false
		},
		"CliSkillWarning": {
			"type": "object",
			"properties": {
				"skillPath": {
					"type": "string"
				},
				"message": {
					"type": "string"
				}
			},
			"required": [
				"skillPath",
				"message"
			],
			"additionalProperties": false
		},
		"CliSkillList": {
			"type": "object",
			"properties": {
				"skills": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/CliSkill"
					}
				},
				"warnings": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/CliSkillWarning"
					}
				}
			},
			"required": [
				"skills",
				"warnings"
			],
			"additionalProperties": false,
			"description": "`omp skill list [dir] --json`."
		}
	}
}
