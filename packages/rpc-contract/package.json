{
	"type": "module",
	"name": "@oh-my-pi/rpc-contract",
	"version": "1.4.0",
	"private": true,
	"description": "Generated omp RPC contract and CLI JSON contract: TypeScript types, JSON Schemas, and contract versions",
	"homepage": "https://omp.sh",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TurtleByte-IN/oh-my-pi.git",
		"directory": "packages/rpc-contract"
	},
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"scripts": {
		"check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '*.ts' && bun run check:types",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint .",
		"fix": "oxlint --fix --fix-suggestions . && bun run fmt",
		"fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '*.ts'"
	},
	"devDependencies": {
		"@types/bun": "catalog:"
	},
	"files": [
		"src",
		"rpc-wire.schema.json",
		"contract.json",
		"cli-contract.schema.json",
		"cli-contract.json",
		"README.md"
	],
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./rpc-wire.schema.json": "./rpc-wire.schema.json",
		"./contract.json": "./contract.json",
		"./cli-contract.schema.json": "./cli-contract.schema.json",
		"./cli-contract.json": "./cli-contract.json"
	}
}
